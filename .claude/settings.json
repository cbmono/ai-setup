{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch --contains:*)",
      "Bash(git branch --merged:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(git config --get:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(gh auth status)",
      "Bash(gh extension list)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh stack view:*)",
      "Bash(gh stack up:*)",
      "Bash(gh stack down:*)",
      "Bash(gh stack top:*)",
      "Bash(gh stack bottom:*)",
      "Bash(gh stack checkout:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npm install)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(npx jest:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec jest:*)",
      "Bash(yarn install)",
      "Bash(yarn install --frozen-lockfile)",
      "Bash(yarn run:*)",
      "Bash(yarn test:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn eslint:*)",
      "Bash(yarn prettier:*)",
      "Bash(yarn vitest:*)",
      "Bash(yarn jest:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bunx tsc:*)",
      "Bash(bunx eslint:*)",
      "Bash(bunx prettier:*)",
      "Bash(bunx vitest:*)",
      "Bash(bunx jest:*)",
      "Bash(node --version)",
      "Bash(coderabbit --help)",
      "Bash(coderabbit review:*)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "Bash(which:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Read(./**)",
      "Edit(./**)",
      "mcp__claude-in-chrome__*"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Edit(**/id_dsa)",
      "Read(**/.aws/credentials)",
      "Edit(**/.aws/credentials)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/hooks/format-on-write.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/hooks/statusline.sh"
  },
  "outputStyle": "Brief",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "skipWorkflowUsageWarning": true
}

# Copy to .env (gitignored) and fill in. Per-machine — everyone keeps their own key.
#
# Only needed if you use the opt-in DeepSeek backend
# (.claude/scripts/deepseek-session.sh). Normal `claude` ignores this file
# entirely; nothing here affects a standard Anthropic session.
#
# See README.md → "DeepSeek as an alternative backend (opt-in)".
DEEPSEEK_API_KEY=sk-xxx
